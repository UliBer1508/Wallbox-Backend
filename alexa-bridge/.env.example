# Kopieren nach .env und ausfüllen. .env NIE weitergeben oder in Git einchecken.

# Sinric Pro: Portal -> Zugangsdaten
SINRIC_APP_KEY=
SINRIC_APP_SECRET=

# Sinric Pro: Geräte-IDs (24 Zeichen)
SINRIC_DEVICE_P30X=6ad71d4fc0d54e0b9e8b480c
SINRIC_DEVICE_P30C=6ad71dd6c0d54e0b9e8b48cd

# Wallbox-Backend (läuft auf demselben PC)
BACKEND_URL=http://127.0.0.1:8080
BACKEND_USER=admin
BACKEND_PASSWORD=

# IDs der Wallboxen wie in config.js des Backends
WALLBOX_PRIVAT=p30x
WALLBOX_GAESTE=p30c

# Obergrenze Ladestrom in A – muss zu maxCurrentA der P30X in config.js passen
MAX_AMPS=16

# Status der Gäste-Wallbox alle X Sekunden lesen (mind. 30)
POLL_SECONDS=30
