# ============================================================
#  Wallbox-Backend — Umgebungsvariablen (.env)
#  Diese Datei nach ".env" kopieren und echte Werte eintragen.
#  Die .env NIEMALS in GitHub committen (steht in .gitignore)!
# ============================================================

# --- Stripe (aus dem Stripe-Dashboard) ---
# Test-Modus: sk_test_... / Live-Betrieb: sk_live_...
STRIPE_SECRET_KEY=sk_test_HIER_DEINEN_STRIPE_SCHLUESSEL
STRIPE_PUBLISHABLE_KEY=pk_test_HIER_DEINEN_PUBLIC_KEY

# --- Öffentliche Basis-URL (für Stripe-Rückleitung nach Zahlung) ---
# Produktiv: https://wallbox.steinbockchalets-charge.com
# Lokal/Test: http://localhost:8080
PUBLIC_BASE_URL=https://wallbox.steinbockchalets-charge.com

# --- Admin-Login ---
# Passwort für den ersten Admin-Benutzer (wird beim ersten Start angelegt).
# UNBEDINGT ein sicheres Passwort setzen!
ADMIN_PASSWORD=BITTE_SICHERES_PASSWORT_SETZEN

# --- Datei-Upload (optional, für das Upload-Modul) ---
# Passwort für den Datei-Upload im Admin. Kann gleich dem ADMIN_PASSWORD sein.
UPLOAD_PASSWORD=BITTE_SICHERES_PASSWORT_SETZEN
# Maximale Upload-Größe in Bytes (Standard 10 MB)
UPLOAD_MAX_BYTES=10485760
